			<!--docker镜像构建及推送原理-->
			<!--1:先将镜像根据下面的配置构建到<dockerHost>所在的docker服务器中(生成对应名称的镜像)-->
			<!--2:然后在根据<serverId>中配置的账户密码,将<dockerHost>中构建的镜像推送到<registryUrl>(harbor仓库)中-->
			<!--执行mvn clean package docker:build,构建镜像并上传镜像到docker仓库中-->
			<!-- docker的maven插件，官网 https://github.com/spotify/docker-maven-plugin -->
			<plugin>
				<groupId>com.spotify</groupId>
				<artifactId>docker-maven-plugin</artifactId>
				<version>1.0.0</version>
				<configuration>
					<!--maven的settings.xml中设置的harbor仓库账户密码,server.id-->
					<serverId>153-docker-repo</serverId>
					<!--提交到harbor的仓库地址,ip,端口-->
					<registryUrl>${docker.registry}:${docker.registry.port}</registryUrl>
					<!--是否向镜像registry(harbor)中推送镜像,如果为false则需要在执行mvn时添加-DpushImage参数-->
					<pushImage>true</pushImage>
					<!--生成的镜像名称,镜像名称，只能有 a-z 小写字母(不能有大写字母)，0-9 ，下划线"_"，和点"." 组成
                        192.168.40.153:9080表示仓库地址，
                        tsg表示组织名称,
                        ${project.build.finalName}镜像名称,使用pom.xml中定义的project.build.finalName
                       ${project.version}表示镜像版本tag，如果不指定，docker有该镜像名，版本号自动更替，
                       没有版本号,使用默认的版本latest,也可以在下面的imageTags标签中指定-->
					<imageName>
						${docker.registry}:${docker.registry.port}/${docker.registry.project.name}/${project.build.finalName}
					</imageName>
					<!--build 时强制覆盖 tag，配合 imageTags 使用-->
					<!--
                                        <forceTags>true</forceTags>
                    -->
					<imageTags>
						<!--指定镜像的tag,可以指定多个标签-->
						<!--<imageTag>${project.version}</imageTag>
						<imageTag>latest</imageTag>-->
					</imageTags>

					<!--Dockerfile的路径,下面放置Dockerfile文件及Dockerfile中依赖的内容,例如config文件夹(数据卷共享)-->
					<dockerDirectory>src/main/resources</dockerDirectory>
					<buildArgs>
						<!--向Dockerfile中传入参数,k-v格式-->
						<!--						<JDK_IMAGE>${docker.registry}:${docker.registry.port}/common/jdk:1.8.0_73</JDK_IMAGE>-->
						<JDK_IMAGE>${docker.registry}:${docker.registry.port}/common/jdk:1.8.0_73</JDK_IMAGE>
						<JAR_FILE>${project.build.finalName}.xjar</JAR_FILE>
					</buildArgs>
					<resources>
						<resource>
							<!--将jar拷贝到/target/docker目录下与Dockerfile放在一起-->
							<targetPath>/</targetPath>
							<directory>${project.build.directory}</directory>
							<include>${project.build.finalName}.xjar</include>
						</resource>

						<resource>
							<!--将jar拷贝到/target/docker目录下与Dockerfile放在一起-->
							<targetPath>/</targetPath>
							<directory>${project.build.directory}</directory>
							<include>xjar.go</include>
						</resource>
						<!--<resource>
							&lt;!&ndash;将properties,logback.xml拷贝到/target/docker/config目录下与Dockerfile放在一起&ndash;&gt;
							<targetPath>/config</targetPath>
							<directory>${project.build.directory}/classes/</directory>
						</resource>-->
					</resources>
					<!--指定构建docker镜像的机器-->
					<dockerHost>http://${docker.build}:${docker.build.port}</dockerHost>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.asciidoctor</groupId>
				<artifactId>asciidoctor-maven-plugin</artifactId>
				<version>2.2.2</version>
				<executions>
					<execution>
						<id>generate-docs</id>
						<phase>prepare-package</phase>
						<goals>
