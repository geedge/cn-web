							<doctype>book</doctype>
							<attributes>
								<snippets>target/generated-snippets</snippets>
							</attributes>
							<sourceDirectory>src/test/resources/asciidoc</sourceDirectory>
							<outputDirectory>src/test/resources/docs</outputDirectory>
						</configuration>
					</execution>
				</executions>
				<dependencies>
