<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.geedge.modules.sys.dao.SysRoleDao">

    <select id="getRolesByUesrId" resultType="net.geedge.modules.sys.entity.SysRoleEntity">
        SELECT
            sr.*
        FROM
            sys_user_role sur
            LEFT JOIN sys_role sr ON sur.role_id = sr.id
        WHERE
            sur.user_id = #{userId}
    </select>

	<select id="getRolesBySysApiKeyId" resultType="net.geedge.modules.sys.entity.SysRoleEntity">
       select 
       		sr.*
       from 
       		sys_api_key sak
       		left join sys_role sr ON sak.role_id = sr.id
       	where 
       		sak.id = #{sysApiKeyId}
    </select>
    
    <select id="selectSysRoleListWithPage" resultType="net.geedge.modules.sys.entity.SysRoleEntity">
    	select * 
    	from sys_role 
    	<where>
    		<if test="params.name !=null and params.name !=''">
    			and name = #{params.name}
    		</if>
    		<if test="params.q !=null and params.q !=''">
    			and name like CONCAT('%', #{params.q}, '%')
    		</if>
    		<if test="params.ids != null and params.ids.size > 0 ">
				id in 
					<foreach item="id" collection="params.ids" separator="," open="(" close=")" index="">
			       		#{id}
				     </foreach>
			</if>
    	</where>
    
    </select>
</mapper>