<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.sys.dao.SysSecurityDao">
    <!-- 查询security -->
    <select id="querySecurity" resultType="string">
        select cvalue from sys_config where ckey = 'security'
    </select>
    <!-- 更新security -->
    <update id="updateSecurity" parameterType="string">
        update sys_config set cvalue = #{paramValue} where ckey = 'security'
    </update>
</mapper>