<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.sys.dao.BasicImportAndExportDao">

    <!--执行自定义SQL将返回结果保存到Map中-->
    <select id="selectDataId" resultType="java.lang.Long">
        SELECT id FROM ${tableName} WHERE knowledge_id = #{knowledgeId} and
		<foreach collection="params.entrySet()" item="value" index="key" separator="and">
			${key} = #{value}
		</foreach>
		<if test="id != null">
            and id != #{id}
        </if>
    </select>

	<delete id="deleteList">
		delete from ${tableName} where id in
		<foreach collection="deleteIds" item="id" separator="," open="(" close=")" >
			#{id}
		</foreach>
	</delete>
	
	<delete id="deleteListByKnowledgeId">
		delete from ${tableName} where knowledge_id = #{knowledgeId}
	</delete>
</mapper>
