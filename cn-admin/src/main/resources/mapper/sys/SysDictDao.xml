<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.geedge.modules.sys.dao.SysDictDao">

	<resultMap id="sysDictResultMap" type="net.geedge.modules.sys.entity.SysDictEntity">
		<result column="id" property="id"></result>
		<result column="name" property="name"></result>
		<result column="code" property="code"></result>
		<result column="value" property="value"></result>
		<result column="i18n" property="i18n"></result>
		<result column="sort" property="sort"></result>
		<result column="remark" property="remark"></result>
		<result column="state" property="state"></result>
		<result column="uby" property="uby"></result>
		<result column="utime" property="utime"></result>
		<association property="uuser" column="uby" select="queryUserById"></association>
	</resultMap>


	<select id="queryNodeImgList" resultType="sysDictEntity">
		SELECT code,value
		FROM sys_dict
		<where>
		    del_flag=0 and type='topo-img'
		</where>
	</select>

	<select id="selectInfo" resultMap="sysDictResultMap">
		select * from sys_dict where state =1 and id = #{id}
	</select>

	<select	id="querySysDictListWithPage" resultMap="sysDictResultMap">
		select *
		from sys_dict
		<where>
			state=1
			<if test="params.q != null and params.q != ''">
				and (name like CONCAT('%', #{params.q}, '%') or code like CONCAT('%', #{params.q}, '%') or value like CONCAT('%', #{params.q}, '%') or remark like CONCAT('%', #{params.q}, '%') )
			</if>
			<if test="params.type != null and params.type != ''">
				and type=#{params.type}
			</if>
			<if test="params.value != null and params.value != ''">
				and value=#{params.value}
			</if>
			<if test="params.ids != null and params.ids.size > 0 ">
				and id in 
					<foreach item="id" collection="params.ids" separator="," open="(" close=")" index="">
			       		#{id}
				     </foreach>
			</if>
		</where>
		order by type,sort
	</select>
	
	<select	id="querySysDictList" resultMap="sysDictResultMap">
		select id,name,type,code,value,sort,remark,uby,utime,i18n
		from sys_dict
		<where>
			state=1
			<if test="params.type != null and params.type != ''">
				and type=#{params.type}
			</if>
			<if test="params.value != null and params.value != ''">
				and value=#{params.value}
			</if>
		</where>
	</select>

	<select id="queryUserById" resultType="net.geedge.modules.sys.entity.SysUserEntity">
		select id,username from sys_user where id=#{id} and status=1
	</select>

	<select id="getMaxTypeCode" resultType="Integer">
		select max(code) from sys_dict where type=#{type}
	</select>
</mapper>