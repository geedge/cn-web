<?xml version="1.0" encoding="UTF-8"?>  
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">    
<mapper namespace="net.geedge.modules.report.dao.ReportTempDao">
	
	<resultMap type="net.geedge.modules.report.entity.ReportTemp" id="reportTemp">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="ctime" column="ctime"/>
        <result property="utime" column="utime"/>
        <result property="uniq" column="uniq"/>
        <result property="source" column="source"/>
        <result property="htmlContent" column="html_content"/>
        <result property="config" column="config"/>
        <result property="remark" column="remark"/>
        <result property="state" column="state"/>
        <result property="uid" column="uid"/>
        <result property="categoryId" column="category_id"/>
        <result property="buildIn" column="build_in"/>
        <result property="schedulerStart" column="scheduler_start"/>
        <result property="schedulerEnd" column="scheduler_end"/>
        <result property="total" column="total"/>
        <result property="lastTime" column="last_time"/>
        
        <association property="sysUser" columnPrefix="u_" javaType="net.geedge.modules.sys.entity.SysUserEntity">
            <id property="id" column="id"/>
            <result property="name" column="name"/>
        </association>
    </resultMap>
	
	<select id="queryPage" resultMap="reportTemp">
      	select 
      	rt.*,
      	su.id as u_id,
      	su.name as u_name,
      	rtj.total as total,
		rtj.ctime as last_time
      	from  report_temp rt 
      	left join sys_user su on rt.uid = su.id
		left join (select rt.id id,count(*) total,max(rj.ctime) ctime from report_temp rt right join report_job rj on rt.id = rj.temp_id group by rt.id order by rj.ctime desc) rtj on rt.id = rtj.id      	
      	<where>
      		<if test="params.name !=null and params.name != ''">
				and rt.name like CONCAT('%', #{params.name}, '%')
			</if>
			<if test="params.categoryId !=null">
				and rt.category_id = #{params.categoryId}
			</if>
			<if test="params.q !=null and params.q != ''">
				and rt.name like CONCAT('%', #{params.q}, '%')
			</if>
      	</where>
      	group by rt.id desc
    </select>
</mapper>