<?xml version="1.0" encoding="UTF-8"?>  
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">    
<mapper namespace="net.geedge.modules.report.dao.ReportCategoryDao">
	
	<resultMap type="net.geedge.modules.report.entity.ReportCategory" id="reportCategory">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="ctime" column="ctime"/>
        <result property="utime" column="utime"/>
        <result property="htmlContent" column="html_content"/>
        <result property="config" column="config"/>
        <result property="remark" column="remark"/>
        <result property="uid" column="uid"/>
        <result property="buildIn" column="build_in"/>
        
        <association property="sysUser" columnPrefix="u_" javaType="net.geedge.modules.sys.entity.SysUserEntity">
            <id property="id" column="id"/>
            <result property="name" column="name"/>
        </association>
    </resultMap>
	
	<select id="queryPage" resultMap="reportCategory">
      	select 
      	rc.*,
      	su.id as u_id,
      	su.name as u_name
      	from  report_category rc 
      	left join sys_user su on rc.uid = su.id
      	<where>
      		<if test="params.name !=null and params.name != ''">
				and rc.name like CONCAT('%', #{params.name}, '%')
			</if>
      	</where>
    </select>
</mapper>