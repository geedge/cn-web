<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.knowledge.dao.TagDao">

    <resultMap id="tag" type="net.geedge.modules.knowledge.entity.Tag">
        <result property="id" column="id"></result>
        <result property="category" column="category"></result>
        <result property="name" column="name"></result>
        <result property="intent" column="intent"></result>
        <result property="indicatorType" column="indicator_type"></result>
        <result property="description" column="description"></result>
        <result property="isBuiltIn" column="is_built_in"></result>
        <result property="createdTime" column="created_time"></result>
        <result property="updatedTime" column="updated_time"></result>
    </resultMap>

    <select id="queryPage" resultMap="tag">
        select * from
        tag
        <where>
            1 = 1
            <if test=" params.name !=null and params.name !='' ">
                and name like concat ( '%', #{params.name}, '%')
            </if>
            <if test="params.intent != null and params.intent.size > 0">
                and intent in
                <foreach item="intent" collection="params.intent" separator="," open="(" close=")" index="">
                    #{intent}
                </foreach>
            </if>
            <if test="params.category != null and params.category.size > 0">
                and category in
                <foreach item="category" collection="params.category" separator="," open="(" close=")" index="">
                    #{category}
                </foreach>
            </if>
            <if test=" params.isBuiltIn !=null and params.isBuiltIn !='' ">
                and is_built_in = #{params.isBuiltIn}
            </if>
        </where>
    </select>


</mapper>