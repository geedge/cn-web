<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.knowledge.dao.DnsServerInfoBuiltInDao">

    <resultMap id="dnsServerInfoBuiltIn" type="net.geedge.modules.knowledge.entity.DnsServerInfoBuiltIn">
        <result property="id" column="id"></result>
        <result property="ipAddr" column="ip_addr"></result>
        <result property="locationCountry" column="location_country"></result>
        <result property="locationProvince" column="location_province"></result>
        <result property="locationRegion" column="location_region"></result>
        <result property="asn" column="asn"></result>
        <result property="dnsServerRolr" column="dns_server_role"></result>
        <result property="orgnization" column="orgnization"></result>
        <result property="operationSystem" column="operation_system"></result>
        <result property="dnsSoftware" column="dns_software"></result>
        <result property="dnssecSupport" column="dnssec_support"></result>
        <result property="dotSupport" column="dot_support"></result>
        <result property="dohSupport" column="doh_support"></result>
        <result property="rootMirrorLocations" column="root_mirror_locations"></result>
        <result property="createTime" column="create_time"></result>
        <result property="updateTime" column="update_time"></result>
    </resultMap>

    <select id="queryIpEntityTag" resultType="java.util.Map">
        select dns_server_role as dnsServerRole, update_time as updateTime,
               create_time as createTime, 1 as isValid from
            cn_dns_server_info_built_in
        where ip_addr = #{resource}
        limit 1
    </select>
</mapper>