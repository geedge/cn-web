<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.knowledge.dao.IpLocationBuiltInDao">

    <resultMap id="IpLocationBuiltIn" type="net.geedge.modules.knowledge.entity.IpLocationBuiltIn">
        <result property="id" column="id"></result>
        <result property="addrType" column="addr_type"></result>
        <result property="startIp" column="start_ip"></result>
        <result property="endIp" column="end_ip"></result>
        <result property="minip" column="minip"></result>
        <result property="maxip" column="maxip"></result>
        <result property="continent" column="continent"></result>
        <result property="areacode" column="areacode"></result>
        <result property="country" column="country"></result>
        <result property="province" column="province"></result>
        <result property="city" column="city"></result>
        <result property="lngwgs" column="lngwgs"></result>
        <result property="latwgs" column="latwgs"></result>
        <result property="owner" column="owner"></result>
        <result property="isp" column="isp"></result>
        <result property="asnumber" column="asnumber"></result>
        <result property="timezone" column="timezone"></result>
        <result property="isValid" column="is_valid"></result>
        <result property="opTime" column="op_time"></result>
        <result property="opUser" column="op_user"></result>
        <result property="knowledgeId" column="knowledge_id"></result>
    </resultMap>
    <select id="queryPageByKnowledgeId" resultMap="IpLocationBuiltIn">
        select * from
        cn_ip_location_built_in
        where knowledge_id = #{params.knowledgeId}
        <if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY id
        </if>
    </select>

    <select id="queryEntityDetail" resultType="java.util.Map">
        select t.continent as continent, t.country as country, t.province as province,
               t.city as city, t.lngwgs as lngwgs, t.latwgs as latwgs, t.isp as isp,
               t.owner as owner, t.knowledge_id as knowledgeId, t.is_valid as isValid from
            (   select * from
                    cn_ip_location_built_in
                where maxip &gt;= #{resource} and length(maxip) = length(#{resource})
                ORDER BY maxip
                limit 1
            ) AS t
        where t.minip &lt;= #{resource}+0
    </select>
</mapper>