<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.knowledge.dao.IpTagUserDefinedDao">

    <resultMap id="IpTagUserDefined" type="net.geedge.modules.knowledge.entity.IpTagUserDefined">
        <result property="id" column="id"></result>
        <result property="tagValue" column="tag_value"></result>
        <result property="tagNames" column="tagNames"></result>
        <result property="startIpBinary" column="start_ip_binary"></result>
        <result property="endIpBinary" column="end_ip_binary"></result>
        <result property="opTime" column="op_time"></result>
        <result property="cTime" column="c_time"></result>
        <result property="opUser" column="op_user"></result>
        <result property="isValid" column="is_valid"></result>
        <result property="knowledgeId" column="knowledge_id"></result>
        <result property="addrFormat" column="addr_format"></result>
        <result property="ipFirst" column="ip_first"></result>
        <result property="ipSecond" column="ip_second"></result>
        <association property="tagNames" resultMap="tagNames"></association>
        <association property="user" column="op_user" select="queryUserById"></association>
    </resultMap>
    <resultMap id="tagNames" type="java.util.Map">
        <result property="addrFormat" column="addr_format"></result>
        <result property="ip1" column="ip_first"></result>
        <result property="ip2" column="ip_second"></result>
    </resultMap>
    <select id="queryPageByKnowledgeId" resultMap="IpTagUserDefined">
        select * from
        cn_ip_tag_user_defined
        where knowledge_id = #{params.knowledgeId}
        <if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY id
        </if>
    </select>


    <select id="queryUserById" resultType="net.geedge.modules.sys.entity.SysUserEntity">
        select id, name
        from sys_user
        where id = #{id}
          and status = 1
    </select>
    
    <insert id="insertBatch">
    	insert into cn_ip_tag_user_defined (tag_value,addr_format,ip_first,ip_second,start_ip_binary,
    	end_ip_binary,op_time,c_time,op_user,is_valid,knowledge_id)
    	values
    	<foreach collection="ipTagUserDefineds" item="ip" separator="," open="(" close=")" index="">
    		#{ip.tagValue},
    		#{ip.addrFormat},
    		#{ip.ipFirst},
    		#{ip.ipSecond},
    		INET6_ATON(#{ip.startIpBinary}),
    		INET6_ATON(#{ip.endIpBinary}),
    		#{ip.opTime},
    		#{ip.cTime},
    		#{ip.opUser},
    		#{ip.isValid},
    		#{ip.knowledgeId}
    	</foreach>
    </insert>
    
    <update id="updateBatch">
    	<foreach collection="ipTagUserDefineds" item="ip" separator=";">
    	 update cn_ip_tag_user_defined  set
    		tag_value = #{ip.tagValue},
    		addr_format = #{ip.addrFormat},
    		ip_first = #{ip.ipFirst},
    		ip_second = #{ip.ipSecond},
    		start_ip_binary = INET6_ATON(#{ip.startIpBinary}),
    		end_ip_binary = INET6_ATON(#{ip.endIpBinary}),
    		op_time = #{ip.opTime},
    		c_time = #{ip.cTime},
    		op_user = #{ip.opUser},
    		is_valid = #{ip.isValid},
    		knowledge_id = #{ip.knowledgeId}
    		where id = #{ip.id}
    	</foreach>
    </update>
</mapper>