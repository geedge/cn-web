<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.knowledge.dao.IpTagUserDefinedDao">

    <resultMap id="IpTagUserDefined" type="net.geedge.modules.knowledge.entity.IpTagUserDefined">
        <result property="id" column="id"></result>
        <result property="tagValue" column="tag_value"></result>
        <result property="tagNames" column="tagNames"></result>
        <result property="startIpBinary" column="start_ip_binary"></result>
        <result property="endIpBinary" column="end_ip_binary"></result>
        <result property="opTime" column="op_time"></result>
        <result property="cTime" column="c_time"></result>
        <result property="opUser" column="op_user"></result>
        <result property="isValid" column="is_valid"></result>
        <result property="knowledgeId" column="knowledge_id"></result>
        <association property="tagNames" resultMap="tagNames"></association>
    </resultMap>
    <resultMap id="tagNames" type="java.util.Map">
        <result property="addrFormat" column="addr_format"></result>
        <result property="ip1" column="ip_first"></result>
        <result property="ip2" column="ip_second"></result>
    </resultMap>
    <select id="queryPageByKnowledgeId" resultMap="IpTagUserDefined">
        select * from
        cn_ip_tag_user_defined
        where knowledge_id = #{params.knowledgeId}
        <if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY id
        </if>
    </select>
</mapper>