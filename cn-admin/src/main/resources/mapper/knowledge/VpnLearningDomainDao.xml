<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.knowledge.dao.VpnLearningDomainDao">

    <resultMap id="VpnLearningDomain" type="net.geedge.modules.knowledge.entity.VpnLearningDomain">
        <result property="id" column="id"></result>
        <result property="domain" column="domain"></result>
        <result property="pluginId" column="plugin_id"></result>
        <result property="pluginName" column="plugin_name"></result>
        <result property="vpnServiceName" column="vpn_service_name"></result>
        <result property="method" column="method"></result>
        <result property="confidence" column="confidence"></result>
        <result property="opTime" column="op_time"></result>
        <result property="cTime" column="c_time"></result>
        <result property="opUser" column="op_user"></result>
        <result property="isValid" column="is_valid"></result>
        <result property="knowledgeId" column="knowledge_id"></result>
    </resultMap>

    <resultMap id="VpnLearningDomainTagMap" type="java.util.Map">
        <result property="pluginId" column="pluginId"></result>
        <result property="pluginName" column="pluginName"></result>
        <result property="vpnServiceName" column="vpnServiceName"></result>
        <result property="method" column="method"></result>
        <result property="confidence" column="confidence"></result>
        <result property="updateTime" column="updateTime"></result>
        <result property="createTime" column="createTime"></result>
        <result property="isValid" column="isValid"></result>
        <result property="knowledgeId" column="knowledgeId"></result>
        <association property="knowledgeBase" column="knowledgeId" select="queryKnowledgeById" javaType="java.util.Map"></association>
    </resultMap>

    <select id="queryKnowledgeById" resultType="java.util.Map">
        select knowledge_id as knowledgeId
        from cn_knowledge_base
        where knowledge_id = #{knowledgeId}
          and status = 1
    </select>

    <select id="queryDomainEntityTag" resultMap="VpnLearningDomainTagMap" parameterType="java.util.Map">
        select plugin_id as pluginId, plugin_name as pluginName, vpn_service_name as vpnServiceName,
               method as method, confidence as confidence, op_time as updateTime,
               c_time as createTime, is_valid as isValid, knowledge_id as knowledgeId from
            cn_vpn_learning_domain
        where domain = #{resource}
    </select>

</mapper>