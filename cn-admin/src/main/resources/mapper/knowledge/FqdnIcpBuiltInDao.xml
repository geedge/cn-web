<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.knowledge.dao.FqdnIcpBuiltInDao">

    <resultMap id="FqdnIcpBuiltIn" type="net.geedge.modules.knowledge.entity.FqdnIcpBuiltIn">
        <result property="id" column="id"></result>
        <result property="fqdn" column="fqdn"></result>
        <result property="source" column="source"></result>
        <result property="querySuccess" column="query_success"></result>
        <result property="isAccessible" column="is_accessible"></result>
        <result property="statusCode" column="status_code"></result>
        <result property="matchPattern" column="match_pattern"></result>
        <result property="icpOwner" column="icp_owner"></result>
        <result property="icpCompanyName" column="icp_company_name"></result>
        <result property="icpCompanyType" column="icp_company_type"></result>
        <result property="icpMainPage" column="icp_main_page"></result>
        <result property="icpSiteLicense" column="icp_site_license"></result>
        <result property="icpSiteName" column="icp_site_name"></result>
        <result property="icpVerifyTime" column="icp_verify_time"></result>
        <result property="createTime" column="create_time"></result>
        <result property="updateTime" column="update_time"></result>
        <result property="knowledgeId" column="knowledge_id"></result>
    </resultMap>
    <select id="queryPageByKnowledgeId" resultMap="FqdnIcpBuiltIn">
        select * from
        cn_fqdn_icp_built_in
        where knowledge_id = #{params.knowledgeId}
        <if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY id
        </if>
    </select>

    <select id="queryEntityDetail" resultType="java.util.Map">
        <choose>
            <when test="!isFuzzyQuery">
                select icp_site_license as icpSiteLicense, icp_company_name as icpCompanyName,
                icp_company_type as icpCompanyType, 1 as isValid, knowledge_id as knowledgeId from
                cn_fqdn_icp_built_in
                where fqdn = #{resource} limit 1
            </when>
            <otherwise>
                select icp_site_license as icpSiteLicense, icp_company_name as icpCompanyName,
                icp_company_type as icpCompanyType, 1 as isValid, knowledge_id as knowledgeId from
                (select * from cn_fqdn_icp_built_in
                where fqdn = SUBSTRING_INDEX(#{resource},'.',-4) or fqdn = SUBSTRING_INDEX(#{resource},'.',-3) or fqdn = SUBSTRING_INDEX(#{resource},'.',-2)) a
                where #{resource} like CONCAT('%','.',fqdn) limit 1
            </otherwise>
        </choose>
    </select>
</mapper>