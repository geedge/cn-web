<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.knowledge.dao.InternalIpBuiltInDao">

    <resultMap id="internalIpBuiltIn" type="net.geedge.modules.knowledge.entity.InternalIpBuiltIn">
        <result property="id" column="id"></result>
        <result property="addrFormat" column="addr_format"></result>
        <result property="ip1" column="ip1"></result>
        <result property="ip2" column="ip2"></result>
        <result property="startIpBinary" column="start_ip_binary"></result>
        <result property="endIpBinary" column="end_ip_binary"></result>
        <result property="knowledgeId" column="knowledge_id"></result>
    </resultMap>
    
    
    <insert id="insertBatchForBinary">
    	insert into cn_internal_ip_built_in (addr_format,ip1,ip2,start_ip_binary,
    	end_ip_binary,knowledge_id)
    	values
    	<foreach collection="internalIpBuiltIns" item="internalIpBuiltIn" separator=",">
    		(
    		#{internalIpBuiltIn.addrFormat},
    		#{internalIpBuiltIn.ip1},
    		#{internalIpBuiltIn.ip2},
    		INET6_ATON(#{internalIpBuiltIn.startIpBinary}),
    		INET6_ATON(#{internalIpBuiltIn.endIpBinary}),
    		#{internalIpBuiltIn.knowledgeId}
    		)
    	</foreach>
    </insert>
    
    <update id="updateBatchForBinary">
    	<foreach collection="internalIpBuiltIns" item="internalIpBuiltIn" separator=";">
    	 update cn_internal_ip_built_in  set
    		addr_format = #{internalIpBuiltIn.addrFormat},
            ip1 = #{internalIpBuiltIn.ip1},
            ip2 = #{internalIpBuiltIn.ip2},
    		start_ip_binary = INET6_ATON(#{internalIpBuiltIn.startIpBinary}),
    		end_ip_binary = INET6_ATON(#{internalIpBuiltIn.endIpBinary}),
    		knowledge_id = #{internalIpBuiltIn.knowledgeId}
    		where id = #{internalIpBuiltIn.id}
    	</foreach>
    </update>
</mapper>