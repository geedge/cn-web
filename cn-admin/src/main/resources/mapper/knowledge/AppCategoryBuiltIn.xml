<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.knowledge.dao.AppCategoryBuiltInDao">

    <resultMap id="AppCategoryBuiltIn" type="net.geedge.modules.knowledge.entity.AppCategoryBuiltIn">
        <result property="id" column="id"></result>
        <result property="appName" column="app_name"></result>
        <result property="appCategory" column="app_category"></result>
        <result property="appSubcategory" column="app_subcategory"></result>
        <result property="appRisk" column="app_risk"></result>
        <result property="appDescription" column="app_description"></result>
        <result property="appLongname" column="app_longname"></result>
        <result property="appTechnology" column="app_technology"></result>
        <result property="appIsProtocol" column="app_is_protocol"></result>
        <result property="appCompany" column="app_company"></result>
        <result property="appCompanyCategory" column="app_company_category"></result>
        <result property="opTime" column="op_time"></result>
        <result property="cTime" column="c_time"></result>
        <result property="opUser" column="op_user"></result>
        <result property="isValid" column="is_valid"></result>
        <result property="knowledgeId" column="knowledge_id"></result>
    </resultMap>
    <select id="queryPageByKnowledgeId" resultMap="AppCategoryBuiltIn">
        select * from
        cn_app_category_built_in
        where knowledge_id = #{params.knowledgeId}
        <if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY id
        </if>
    </select>

    <select id="queryEntityDetail" resultType="java.util.Map">
        select app_name as appName, id as appId, app_category as appCategory, app_subcategory as appSubcategory, app_risk as appRisk, app_description as appDescription, app_longname as appLongname, app_technology as appTechnology, app_company as appCompany, app_company_category as appCompanyCategory from
        cn_app_category_built_in
        where app_name = #{resource}
        limit 1
    </select>
</mapper>