<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.knowledge.dao.LinkDirectionBuiltInDao">

    <resultMap id="linkDirectionBuiltIn" type="net.geedge.modules.knowledge.entity.LinkDirectionBuiltIn">
        <result property="id" column="id"></result>
        <result property="interfaceName" column="interface_name"></result>
        <result property="direction" column="direction"></result>
        <result property="bandwidth" column="bandwidth"></result>
        <result property="peerProvince" column="peer_province"></result>
        <result property="peerCity" column="peer_city"></result>
     	<result property="linkId" column="link_id"></result>
    </resultMap>

    <select id="queryPage" resultMap="linkDirectionBuiltIn">
        select * from
        cn_link_direction_built_in
        <if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY id
        </if>
    </select>
</mapper>