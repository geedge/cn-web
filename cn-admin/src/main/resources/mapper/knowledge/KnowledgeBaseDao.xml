<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.knowledge.dao.KnowledgeBaseDao">

    <resultMap id="knowledgeBase" type="net.geedge.modules.knowledge.entity.KnowledgeBase">
        <result property="id" column="id"></result>
        <result property="tagName" column="tag_name"></result>
        <result property="tagType" column="tag_type"></result>
        <result property="remark" column="remark"></result>
        <result property="cby" column="cby"></result>
        <result property="ctime" column="ctime"></result>
        <result property="uby" column="uby"></result>
        <result property="utime" column="utime"></result>
        <result property="knowledgeId" column="knowledge_id"></result>
        <association property="uuser" column="uby" select="queryUserById"></association>
        <association property="cuser" column="cby" select="queryUserById"></association>
    </resultMap>

    <select id="queryPage" resultMap="knowledgeBase">
        select * from
        knowledge_base
        <where>
            <if test=" params.q !=null and params.q !='' ">
                tag_name like concat ( '%', #{params.q}, '%')
            </if>
            <if test=" params.tagType !=null ">
            	 and tag_type = #{params.tagType}
            </if>
        </where>
        <if test="params.orderBy == null or params.orderBy == ''">
			ORDER BY id desc
		</if>
    </select>
    
    <select id="queryUserById" resultType="net.geedge.modules.sys.entity.SysUserEntity">
        select id, username
        from sys_user
        where id = #{id}
        and status = 1
    </select>
</mapper>