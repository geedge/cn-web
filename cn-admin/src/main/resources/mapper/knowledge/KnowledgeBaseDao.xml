<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.knowledge.dao.KnowledgeBaseDao">

    <resultMap id="knowledgeBase" type="net.geedge.modules.knowledge.entity.KnowledgeBase">
        <result property="knowledgeId" column="knowledge_id"></result>
        <result property="name" column="name"></result>
        <result property="category" column="category"></result>
        <result property="source" column="source"></result>
        <result property="description" column="description"></result>
        <result property="opTime" column="op_time"></result>
        <result property="cTime" column="c_time"></result>
        <result property="opUser" column="op_user"></result>
        <result property="isBuiltIn" column="is_built_in"></result>
        <result property="isPublished" column="is_published"></result>
        <result property="status" column="status"></result>
        <association property="user" column="op_user" select="queryUserById"></association>
    </resultMap>

    <select id="queryPage" resultMap="knowledgeBase">
        select * from
        cn_knowledge_base
        <where>
            1 = 1
            <if test=" params.name !=null and params.name !='' ">
                and name like concat ( '%', #{params.name}, '%')
            </if>
            <if test="params.category != null and params.category.size > 0">
                and category in
                <foreach item="category" collection="params.category" separator="," open="(" close=")" index="">
                    #{category}
                </foreach>
            </if>
            <if test="params.source != null and params.source.size > 0">
                and source in
                <foreach item="source" collection="params.source" separator="," open="(" close=")" index="">
                    #{source}
                </foreach>
            </if>
            <if test="params.status != null and params.status.size > 0">
                and status in
                <foreach item="status" collection="params.status" separator="," open="(" close=")" index="">
                    #{status}
                </foreach>
            </if>
        </where>
        <choose>
            <when test="params.orderBy != null and params.orderBy != ''">
                ORDER BY ${params.orderBy}
            </when>
            <otherwise>
                ORDER BY knowledge_id desc
            </otherwise>
        </choose>
    </select>

    <select id="queryUserById" resultType="net.geedge.modules.sys.entity.SysUserEntity">
        select id, name
        from sys_user
        where id = #{id}
          and status = 1
    </select>

    <select id="queryInfo" resultMap="knowledgeBase">
        select * from
            cn_knowledge_base
        where knowledge_id = #{knowledgeId}
    </select>

    <select id="queryList" resultMap="knowledgeBase">
        select * from
        cn_knowledge_base
        <where>
            1 = 1
            <if test="params.category != null and params.category.size > 0">
                and category in
                <foreach item="category" collection="params.category" separator="," open="(" close=")" index="">
                    #{category}
                </foreach>
            </if>
            <if test="params.source != null and params.source.size > 0">
                and source in
                <foreach item="source" collection="params.source" separator="," open="(" close=")" index="">
                    #{source}
                </foreach>
            </if>
            <if test="params.status != null and params.status.size > 0">
                and status in
                <foreach item="status" collection="params.status" separator="," open="(" close=")" index="">
                    #{status}
                </foreach>
            </if>
        </where>
        <if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY knowledge_id desc
        </if>
    </select>
    
    <delete id="deleteBySource">
    	delete from ${source} where knowledge_id in 
    	<foreach item="knowledgeId" collection="knowledgeIds" separator="," open="(" close=")" index="">
            #{knowledgeId}
        </foreach>
    </delete>
</mapper>