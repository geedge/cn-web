<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.knowledge.dao.IdcRenterBuiltInDao">

    <resultMap id="idcRenterBuiltIn" type="net.geedge.modules.knowledge.entity.IdcRenterBuiltIn">
        <result property="id" column="id"></result>
        <result property="addrFormat" column="addr_format"></result>
        <result property="ip1" column="ip1"></result>
        <result property="ip2" column="ip2"></result>
        <result property="startIpBinary" column="start_ip_binary"></result>
        <result property="endIpBinary" column="end_ip_binary"></result>
        <result property="idcRenter" column="idc_renter"></result>
    </resultMap>
    
    <insert id="insertBatchForBinary">
    	insert into cn_idc_renter_built_in (addr_format,ip1,ip2,start_ip_binary,
    	end_ip_binary,idc_renter)
    	values
    	<foreach collection="idcRenterBuiltIns" item="idcRenterBuiltIn" separator=",">
    		(
    		#{idcRenterBuiltIn.addrFormat},
    		#{idcRenterBuiltIn.ip1},
    		#{idcRenterBuiltIn.ip2},
    		INET6_ATON(#{idcRenterBuiltIn.startIpBinary}),
    		INET6_ATON(#{idcRenterBuiltIn.endIpBinary}),
    		#{idcRenterBuiltIn.idcRenter}
    		)
    	</foreach>
    </insert>
    
    <update id="updateBatchForBinary">
    	<foreach collection="idcRenterBuiltIns" item="idcRenterBuiltIn" separator=";">
    	 update cn_idc_renter_built_in  set
    		addr_format = #{idcRenterBuiltIn.addrFormat},
            ip1 = #{idcRenterBuiltIn.ip1},
            ip2 = #{idcRenterBuiltIn.ip2},
    		start_ip_binary = INET6_ATON(#{idcRenterBuiltIn.startIpBinary}),
    		end_ip_binary = INET6_ATON(#{idcRenterBuiltIn.endIpBinary}),
    		idc_renter = #{idcRenterBuiltIn.idcRenter}
    		where id = #{idcRenterBuiltIn.id}
    	</foreach>
    </update>

	<select id="queryPage" resultMap="idcRenterBuiltIn">
		select * from
		cn_idc_renter_built_in
		<if test="params.orderBy == null or params.orderBy == ''">
			ORDER BY id
		</if>
	</select>
</mapper>