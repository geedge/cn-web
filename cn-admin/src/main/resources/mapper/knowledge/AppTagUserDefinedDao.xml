<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.geedge.modules.knowledge.dao.AppTagUserDefinedDao">

    <resultMap id="AppTagUserDefined" type="net.geedge.modules.knowledge.entity.AppTagUserDefined">
        <result property="id" column="id"></result>
        <result property="tagValue" column="tag_value"></result>
        <result property="appName" column="app_name"></result>
        <result property="opTime" column="op_time"></result>
        <result property="cTime" column="c_time"></result>
        <result property="opUser" column="op_user"></result>
        <result property="isValid" column="is_valid"></result>
        <result property="knowledgeId" column="knowledge_id"></result>
        <association property="user" column="op_user" select="queryUserById"></association>
    </resultMap>

    <resultMap id="AppTagMap" type="java.util.Map">
        <result property="id" column="id"></result>
        <result property="tagValue" column="tagValue"></result>
        <result property="updateTime" column="updateTime"></result>
        <result property="createTime" column="createTime"></result>
        <result property="isValid" column="isValid"></result>
        <result property="knowledgeId" column="knowledgeId"></result>
        <association property="knowledgeBase" column="knowledgeId" select="queryKnowledgeById">
            <result property="knowledgeId" column="knowledgeId"></result>
            <result property="color" column="color"></result>
        </association>
    </resultMap>

    <select id="queryPageByKnowledgeId" resultMap="AppTagUserDefined">
        select * from
        cn_app_tag_user_defined
        where knowledge_id = #{params.knowledgeId}
        <if test="params.orderBy == null or params.orderBy == ''">
            ORDER BY id
        </if>
    </select>

    <select id="queryUserById" resultType="net.geedge.modules.sys.entity.SysUserEntity">
        select id, name
        from sys_user
        where id = #{id}
          and status = 1
    </select>

    <select id="queryKnowledgeById" resultType="java.util.Map">
        select knowledge_id as knowledgeId, color
        from cn_knowledge_base
        where knowledge_id = #{knowledgeId}
          and status = 1
    </select>

    <select id="queryAppEntityTag" resultMap="AppTagMap" parameterType="java.util.Map">
        select id as id, tag_value as tagValue, op_time as updateTime,
               c_time as createTime, is_valid as isValid, knowledge_id as knowledgeId from
        cn_app_tag_user_defined
        where app_name = #{resource}
    </select>
</mapper>